# ─── Supabase (required for auth + data) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here # REQUIRED — without this, AI memory and personalization are disabled

# ─── Groq AI (required for AI Coach, Break My Startup, Generate Roadmap) ────
# Get your free key at: https://console.groq.com/keys
# Primary model for ALL roles (fast, reasoning, reflexion pipeline):
#   openai/gpt-oss-120b — OpenAI's open-weight 120B MoE, Apache 2.0, free tier.
#   Matches o4-mini on reasoning benchmarks. Used with reasoning_effort=high
#   for Reflexion Generator, Critic, Verifier, Refiner, and Break My Startup.
# Fallback (fast chain only): llama-3.3-70b-versatile (same Groq key, auto-rotated on 429)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ─── Cerebras AI (optional — adds 1,854 t/s fallback inference) ─────────────
# Get your free key at: https://cloud.cerebras.ai
# gpt-oss-120b on Cerebras is the fastest inference available for this model.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# ─── Google Gemini (optional — adds multimodal fallback) ─────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Gemini 2.5 Flash: stronger reasoning + lower hallucination vs 2.0 Flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Billing / email ────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BUILDER_PLAN_CODE= # GHS plan (for Ghana users)
PAYSTACK_BUILDER_PLAN_CODE_USD= # USD plan (for global users)
PAYSTACK_AMOUNT_BUILDER=44300 # GHS 443 = $39 @ BoG rate 11.34 (13 May 2026)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx # REQUIRED — without this, billing confirmation emails are silently skipped
# Email sender address — must match a domain verified in your Resend account
EMAIL_FROM=BuildMind <hello@buildmind.live>

# ─── Observability (optional but strongly recommended in production) ─────────
# Sentry: captures crashes in reflexion pipeline, billing webhooks, cron jobs.
# Install: npm install @sentry/nextjs  then npx @sentry/wizard@latest -i nextjs
# Free tier covers up to 5,000 errors/month.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Re-engagement / retention ──────────────────────────────────────────────
# Days of inactivity before a re-engagement email is sent (default: 7).
# The cron job checks daily and sends once per user per window.
REENGAGEMENT_INACTIVE_DAYS=7

# ─── Push Notifications (required for push features) ─────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY= # REQUIRED for push notifications — generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY= # REQUIRED for push notifications — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:hello@buildmind.live

# ─── Cron Security (required for evening-check + re-engage crons) ────────────
# Any strong random string: openssl rand -hex 32
CRON_SECRET= # REQUIRED — without this, all cron jobs (briefings, re-engagement, reports) are dead

# ─── Admin Access ────────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs with admin access
# e.g. ADMIN_USER_IDS=uuid1,uuid2
ADMIN_USER_IDS=

# ─── App URL (required for queue fan-out and absolute links in emails) ────────
# Your production domain, no trailing slash
APP_URL=https://buildmind.live

# ─── Integrations: OAuth credentials & state secret ─────────────────────────
# Notion OAuth (get from https://www.notion.so/profile/integrations → New integration → OAuth)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Linear OAuth (get from https://linear.app/settings/api → OAuth Applications → New)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# OAuth state signing secret — any random 32+ character string, generate with: openssl rand -hex 16
OAUTH_STATE_SECRET=
