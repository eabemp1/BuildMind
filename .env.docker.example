# ── Database (FastAPI backend) ─────────────────────────────────────────────
# Supabase free tier (recommended): get from supabase.com → Settings → Database
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Neon free tier alternative: neon.tech
# DATABASE_URL=postgresql://[user]:[password]@[host]/[db]?sslmode=require
DATABASE_URL=sqlite:///./evolvai.db

JWT_SECRET=change_me
SECRET_KEY=change_me
GROQ_API_KEY=change_me
SUPABASE_SERVICE_ROLE_KEY=change_me
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key
NEXT_PUBLIC_ADMIN_USER_ID=change_me
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=change_me
NEXT_PUBLIC_PAYSTACK_PLAN_BUILDER=
PAYSTACK_SECRET_KEY=change_me
NEXT_PUBLIC_PAYSTACK_AMOUNT_BUILDER=29000
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=change_me
NEXT_PUBLIC_PADDLE_PRICE_BUILDER=change_me
PADDLE_API_KEY=change_me
PADDLE_WEBHOOK_SECRET=change_me
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change_me
VAPID_PRIVATE_KEY=change_me
VAPID_SUBJECT=mailto:hello@buildmind.live
CRON_SECRET=change_me
NEXT_PUBLIC_POSTHOG_KEY=change_me
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Feature flags (default OFF in code; set to 1/true to enable)
NEXT_PUBLIC_FEATURE_VENTURES=0
NEXT_PUBLIC_FEATURE_EXPLORE=0
# Dev override (set to "builder" to bypass billing locally)
NEXT_PUBLIC_USER_PLAN=
# Rate limiting
SLOWAPI_DEFAULT_LIMIT=200/minute
# Enable weekly report cron
ENABLE_WEEKLY_REPORT_CRON=0
# Agent path prefix (sub-app mount)
AGENT_MOUNT_PREFIX=/agent
