# ── Database (FastAPI backend) ─────────────────────────────────────────────
# Supabase free tier (recommended): get from supabase.com → Settings → Database
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Neon free tier alternative: neon.tech
# DATABASE_URL=postgresql://[user]:[password]@[host]/[db]?sslmode=require
DATABASE_URL=sqlite:///./evolvai.db

JWT_SECRET=change_me
SECRET_KEY=change_me
GROQ_API_KEY=change_me
SUPABASE_SERVICE_ROLE_KEY=change_me
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=change_me
NEXT_PUBLIC_SUPABASE_ANON_KEY=change_me
NEXT_PUBLIC_POSTHOG_KEY=change_me
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_ADMIN_USER_ID=change_me
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=change_me
PAYSTACK_SECRET_KEY=change_me
PAYSTACK_BUILDER_PLAN_CODE= # GHS plan (for Ghana users)
PAYSTACK_BUILDER_PLAN_CODE_USD= # USD plan (for global users)
PAYSTACK_AMOUNT_BUILDER=44300 # GHS 443 = $39 @ BoG rate 11.34 (13 May 2026)
# Rate limiting
SLOWAPI_DEFAULT_LIMIT=200/minute
# Enable weekly report cron
ENABLE_WEEKLY_REPORT_CRON=0
# Agent path prefix (sub-app mount)
AGENT_MOUNT_PREFIX=/agent
